# Kopiere diese Datei nach .env und trage eigene Werte ein.
# .env ist in .gitignore — Geheimnisse gehören nicht ins Repo.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# SQLite im Entwicklungsbetrieb. Für PostgreSQL siehe README.
DATABASE_URL="file:./dev.db"

# Mindestens 32 Zeichen. Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=bitte-ersetzen-mindestens-zweiunddreissig-zeichen

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60

LICHESS_API_URL=https://lichess.org

# Komma-getrennt. Leer lassen, solange nur die App zugreift.
CORS_ORIGINS=

RATE_LIMIT_PER_MINUTE=120
