<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Sichtbar, solange der Prozess startet. Dunkel auch bei heller
         Systemeinstellung: der Startbildschirm trägt das Icon auf
         Nocturne-Grund, und ein weisser Rahmen darum sähe wie ein Fehler aus.
         Die App selbst folgt danach der gewählten Einstellung. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Gilt, sobald Flutter zeichnet. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
